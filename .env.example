# Local development example only.
# Choose your own password for a new setup.
# Keep the credentials consistent in all four settings below.

POSTGRES_USER=sdet
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=sdet_practice_lab

# Used by tools running directly on your computer.
DATABASE_URL="postgresql://sdet:replace_with_local_password@127.0.0.1:5432/sdet_practice_lab?schema=public"

# Used by services running inside Docker Compose.
DOCKER_DATABASE_URL="postgresql://sdet:replace_with_local_password@db:5432/sdet_practice_lab?schema=public"